# 云雾 API（OpenAI 兼容）— 文本 + 图片
YUNWU_API_KEY=sk-your-yunwu-key
YUNWU_BASE_URL=https://api.yunwu.ai
YUNWU_TEXT_MODEL=gpt-5.4
YUNWU_IMAGE_BASE_URL=https://api.yunwu.ai/v1
YUNWU_IMAGE_MODEL=gpt-image-2

# 火山引擎官方 API — 视频 Seedance
VOLCENGINE_API_KEY=ark-your-volcengine-key
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com
VOLCENGINE_VIDEO_MODEL=doubao-seedance-2-0-mini-260615

# 生产环境
# PORT=5679
# 备份保留份数（启动/每日各备份一次，超出后删除最旧的）
BACKUP_KEEP=10
# HUAIHUA_AGENT_CREDITS=10
# HUAIHUA_IMAGE_CREDITS=10
# CORS_ORIGINS=https://你的域名
HUAIHUA_LOCAL_CREDITS=9999
# HUAIHUA_LOCAL_USERNAME=本地用户

# 扣费定价 — 成本驱动（见 backend/src/config/pricing.ts）
# HUAIHUA_CREDIT_RMB_VALUE=0.09
# HUAIHUA_AGENT_API_COST_RMB=0.054
# HUAIHUA_AGENT_MARGIN=5
# HUAIHUA_IMAGE_API_COST_RMB=0.09
# HUAIHUA_IMAGE_MARGIN=5
# 视频 Mini（火山官方 0.4 元/秒）：标价 16 积分/秒，实扣 12 积分/秒（75 折）
# HUAIHUA_VIDEO_MINI_API_COST_RMB=0.4
# HUAIHUA_VIDEO_LIST_CREDITS_PER_SECOND=16
# HUAIHUA_VIDEO_CHARGE_CREDITS_PER_SECOND=12
# HUAIHUA_VIDEO_DISCOUNT_LABEL=75折
# HUAIHUA_VIDEO_MAX_DURATION=15
